# Copia este archivo como ".env" (en esta misma carpeta) y cambia los valores.
# El archivo .env NO se sube a git porque contiene contraseñas.

# Puerto donde escucha la API.
PORT=3000

# Cadena de conexión a PostgreSQL:
# postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE_DE_DATOS
# Si la contraseña tiene caracteres especiales (@ : / # ?), escríbelos
# codificados, por ejemplo "@" se escribe "%40".
DATABASE_URL=postgresql://postgres:TU_CONTRASEÑA@localhost:5432/subtrack

# Clave secreta para firmar los tokens JWT. Usa un texto largo y aleatorio.
# Puedes generar uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_texto_largo_y_aleatorio
