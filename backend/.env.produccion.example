# Copia este archivo como ".env.produccion" (en esta misma carpeta) y pega la
# cadena de conexión de Neon. Lo usan solo los comandos "...:nube":
#   npm run db:migrate:nube
#   npm run db:guias:nube
#   npm run db:demo:nube
# Así tu .env local (base "subtrack" en tu PC) no se toca.
# .env.produccion NO se sube a git (está en .gitignore): tiene la contraseña.

DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@ep-xxxx-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
