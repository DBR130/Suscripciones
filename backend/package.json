{
  "name": "subtrack-backend",
  "version": "1.0.0",
  "description": "API REST de SubTrack (autenticación) con Express y PostgreSQL",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file=.env src/server.js",
    "db:migrate": "node --env-file=.env db/migrar.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
