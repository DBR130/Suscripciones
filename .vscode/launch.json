{
    // Usa IntelliSense para saber los atributos posibles.
    // Mantén el puntero para ver las descripciones de los existentes.
    // Para más información, visita: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            // Backend en el mismo PC: la app de escritorio lo ve en localhost.
            "name": "Windows (localhost)",
            "request": "launch",
            "type": "dart",
            "deviceId": "windows",
            "args": ["--dart-define=API_URL=http://localhost:3000"]
        },
        {
            // Xiaomi por USB. Antes de lanzar, en una terminal:
            //   adb reverse tcp:3000 tcp:3000
            // así el celular ve el backend del PC en su propio localhost:3000.
            "name": "Celular USB (localhost)",
            "request": "launch",
            "type": "dart",
            "deviceId": "25080RABDG",
            "args": ["--dart-define=API_URL=http://localhost:3000"]
        },
        {
            // Xiaomi contra el backend en Render (sin USB ni el PC encendido).
            // Cambia TU-SERVICIO por el nombre real del servicio en Render
            // (ver docs/despliegue.md). La primera petición puede tardar
            // cerca de 1 minuto si el servidor estaba dormido.
            "name": "Celular (nube)",
            "request": "launch",
            "type": "dart",
            "deviceId": "25080RABDG",
            "args": ["--dart-define=API_URL=https://subtrack-api-4150.onrender.com"]
        },
        {
            // Sin dart-define: usa http://10.0.2.2:3000 (el PC visto desde el emulador).
            "name": "Emulador Android",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "flutter_suscripciones (Chrome)",
            "request": "launch",
            "type": "dart",
            "deviceId": "chrome"
        },
        {
            "name": "flutter_suscripciones (Windows)",
            "request": "launch",
            "type": "dart",
            "deviceId": "windows"
        },
        {
            "name": "flutter_suscripciones (Edge)",
            "request": "launch",
            "type": "dart",
            "deviceId": "edge"
        },
        {
            "name": "flutter_suscripciones (Profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        }
    ]
}
