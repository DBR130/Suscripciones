<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Solo en debug: permite HTTP sin cifrar para hablar con el backend
         local (http://localhost:3000 por USB, o http://10.0.2.2:3000 en el
         emulador), que no tiene HTTPS. Reemplaza el "false" del manifest
         principal; release y profile se quedan solo con HTTPS. -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic">
        <!-- Solo en debug: forzar la tarea de fondo desde el PC.
             adb shell am broadcast -a com.example.flutter_suscripciones.PROCESAR_COLA -p com.example.flutter_suscripciones -->
        <receiver
            android:name=".deteccion.ProcesarColaReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.flutter_suscripciones.PROCESAR_COLA" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
